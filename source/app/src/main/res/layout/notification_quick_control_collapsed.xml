<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notification_card"
    android:paddingHorizontal="10dp"
    android:paddingVertical="7dp">

    <!-- Hàng 1: Tiêu đề, Huy hiệu cỡ chữ và 2 nút tinh chỉnh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Cỡ chữ:"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_collapsed_scale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="1.20x"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_scale_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_collapsed_down"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_button"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_collapsed_up"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_button"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Hàng 2: Thanh trượt tiến trình trực quan (Visual Slider Track) -->
    <ProgressBar
        android:id="@+id/pb_collapsed_track"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="30"
        android:progressDrawable="@drawable/custom_progress_track" />

    <!-- Hàng 3: 4 Mốc chạm thanh trượt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_collapsed_85"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:text="0.85x"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_track_node"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_collapsed_100"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="1.00x"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_track_node"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_collapsed_125"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="1.25x"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_track_node"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_collapsed_150"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="1.50x"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_track_node"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

</LinearLayout>
